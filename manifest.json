{
    "manifest_version": 3,
    "name": "Manage My Tabs",
    "version": "1.0.0",
    "description": "Save and restore browser workspaces",
  
    "permissions": [
      "tabs",
      "storage"
    ],
  
    "action": {
      "default_popup": "popup/popup.html"
    },
    "icons":{
   
      "48": "a.png"
     

    },
  
    "background": {
      "service_worker": "background/background.js"
    }
  }